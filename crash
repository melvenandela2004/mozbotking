  </div>
</section>

<section id="userScreen" class="layout hidden">
  <aside class="sidebar">
    <div class="brand">⚡ CRASH <span>MOZ</span></div>
    <button class="nav active" data-page="home">⌂ Início</button>
    <button class="nav" data-page="demo">◈ Sinais</button>
    <button class="nav" data-page="profile">♙ Meu perfil</button>
    <button class="nav" data-page="support">☏ Suporte</button>
    <div class="side-bottom">
      ● Sessão ativa<br><span id="sideEmail"></span>
      <button class="secondary full" id="logout">Sair da conta</button>
    </div>
  </aside>

  <main>
    <div id="homePage">
      <div class="hero">
        <div class="eyebrow">BEM-VINDO À PLATAFORMA</div>
        <h1>Olá, <span id="welcome"></span>!</h1>
        <p class="muted">Consulta os horários no fuso horário de Moçambique.</p>
        <button id="goDemo">ABRIR PAINEL DE SINAIS →</button>
      </div>
      <div class="cards">
        <div class="stat"><small>ESTADO DA CONTA</small><strong style="color:var(--green)">Ativa</strong></div>
        <div class="stat"><small>FUSO HORÁRIO</small><strong>Africa/Maputo</strong></div>
      </div>
    </div>

    <div id="demoPage" class="hidden">
      <div class="hero">
        <div class="eyebrow">PAINEL DE HORÁRIOS</div>
        <h1>Sinais <span style="color:var(--cyan)">CRASH MOZ</span></h1>
        <p class="muted">Horários apresentados segundo o relógio de Moçambique.</p>
        <div>Hora de Moçambique:</div>
        <div id="maputoClock" class="clock">--:--:--</div>
