  <div class="notice">Versão local: as contas ficam neste navegador. Para utilização pública, configura Firebase Authentication e regras de segurança no servidor.</div>
</section>

<footer>CRASH BOT MOZ · Sinais demonstrativos · Joga com responsabilidade</footer>
</div>

<div id="adminModal" class="modal-bg hidden">
  <div class="modal">
    <div class="brand">🔐 Painel <span>Admin</span></div>
    <h2>Acesso do Administrador</h2>
    <form id="adminForm">
      <label>Senha do administrador<input id="adminPassword" type="password" required></label>
      <button class="full">ACEDER AO PAINEL</button>
      <div id="adminError" class="error"></div>
    </form>
    <button id="closeModal" class="secondary full">Cancelar</button>
  </div>
</div>

<script>
(function(){
"use strict";

const ADMIN_PASSWORD="665544";
const STORAGE_KEY="crashBotMozUsers";
const LOCK_KEY="crashBotMozLocksByCombinationV2";
const WHATSAPP_NUMBER="258873540295";
const TIME_ZONE="Africa/Maputo";
const $=id=>document.getElementById(id);

let currentUser=null;
let editingEmail=null;
let selectedBet="";
let selectedGame="";
let signals=[];

function readLocks(){
  try{
    const value=JSON.parse(localStorage.getItem(LOCK_KEY)||"{}");
    return value&&typeof value==="object"?value:{};
  }catch{return {};}
}
function saveLocks(locks){
  localStorage.setItem(LOCK_KEY,JSON.stringify(locks));
}
function combinationKey(bet=selectedBet,game=selectedGame){
  return bet+"::"+game;
}
function getCombinationLock(key=combinationKey()){
  return Number(readLocks()[key]||0);
}
function setCombinationLock(key,timestamp){
  const locks=readLocks();
  locks[key]=timestamp;
  saveLocks(locks);
}
function clearExpiredLocks(){
  const locks=readLocks();
  const now=Date.now();
  let changed=false;
  for(const key of Object.keys(locks)){
    if(Number(locks[key])<=now){
      delete locks[key];
      changed=true;
    }
  }
  if(changed)saveLocks(locks);
}

function whatsappURL(message){
  return "https://wa.me/"+WHATSAPP_NUMBER+"?text="+encodeURIComponent(message);
}
$("createAccountLink").href=whatsappURL("Olá! Quero criar uma conta no CRASH BOT MOZ.");
$("supportCreateAccount").href=whatsappURL("Olá! Gostaria de solicitar a criação de uma conta.");
$("loginSupportLink").href=whatsappURL("Olá! Preciso de ajuda com o CRASH BOT MOZ.");
$("supportWhatsApp").href=whatsappURL("Olá! Preciso de suporte.");

const bettingSites=[
  {name:"ElephantBet",logo:"🐘"},
  {name:"888Bet",logo:"888"},
  {name:"PrideBet",logo:"🏆"},
  {name:"JogaBet",logo:"⚽"},
  {name:"Betway",logo:"B"},
  {name:"Betyetu",logo:"🎯"},
  {name:"Placard",logo:"P"},
  {name:"Megagame Live",logo:"🎮"},
  {name:"Sportbet",logo:"🏅"}
];
const games=[
  {name:"Aviator",icon:"✈️"},
  {name:"JetX",icon:"🚀"},
  {name:"Aero",icon:"🛩️"},
  {name:"Earplane",icon:"🛫"}
];

function getUsers(){
  try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");}
  catch{return [];}
}
function saveUsers(users){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(users));
}
function escapeHTML(value){
  return String(value).replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}
function showScreen(id){
  ["loginScreen","userScreen","adminScreen"].forEach(s=>$(s).classList.add("hidden"));
  $(id).classList.remove("hidden");
  window.scrollTo({top:0,behavior:"smooth"});
}
function openUserPage(page){
  ["home","demo","profile","support"].forEach(p=>{
    $(p+"Page").classList.toggle("hidden",p!==page);
  });
  document.querySelectorAll(".nav").forEach(b=>{
    b.classList.toggle("active",b.dataset.page===page);
  });
  if(page==="demo"){
    renderChoices();
    updateGenerationLock();
  }
}
function renderChoices(){
  $("betGrid").innerHTML=bettingSites.map(site=>`
    <div class="bet-card ${selectedBet===site.name?"selected":""}"
      data-bet="${escapeHTML(site.name)}" tabindex="0" role="button"
      aria-pressed="${selectedBet===site.name}">
      <div class="bet-logo">${site.logo}</div><b>${site.name}</b>
      <p>Plataforma selecionável</p>
    </div>`).join("");

  $("gameGrid").innerHTML=games.map(game=>`
    <div class="game-card ${selectedGame===game.name?"selected":""}"
      data-game="${escapeHTML(game.name)}" tabindex="0" role="button"
      aria-pressed="${selectedGame===game.name}">
      <div class="game-icon">${game.icon}</div><b>${game.name}</b>
      <p>Jogo selecionável</p>
    </div>`).join("");

  $("chosenBet").textContent=selectedBet||"Nenhuma";
  $("chosenGame").textContent=selectedGame||"Nenhum";
}

function handleChoice(e){
  const card=e.target.closest("[data-bet],[data-game]");
  if(!card)return;
  const oldKey=combinationKey();

  if(card.dataset.bet)selectedBet=card.dataset.bet;
  else selectedGame=card.dataset.game;

  const newKey=combinationKey();
  if(newKey!==oldKey){
    signals=[];
    $("signalGrid").innerHTML="";
    $("resultsPanel").classList.add("hidden");
    $("selectionMessage").textContent="";
  }
  renderChoices();
  updateGenerationLock();
}
$("betGrid").addEventListener("click",handleChoice);
$("gameGrid").addEventListener("click",handleChoice);

["betGrid","gameGrid"].forEach(id=>{
  $(id).addEventListener("keydown",e=>{
    if(e.key==="Enter"||e.key===" "){
      const card=e.target.closest("[data-bet],[data-game]");
      if(card){e.preventDefault();card.click();}
    }
  });
});

function formatTime(date){
  return new Intl.DateTimeFormat("pt-MZ",{
    timeZone:TIME_ZONE,hour:"2-digit",minute:"2-digit",hourCycle:"h23"
  }).format(date);
}
function updateClock(){
  $("maputoClock").textContent=new Intl.DateTimeFormat("pt-MZ",{
    timeZone:TIME_ZONE,hour:"2-digit",minute:"2-digit",second:"2-digit",hourCycle:"h23"
  }).format(new Date());
}
updateClock();
setInterval(updateClock,1000);

function generateSchedule(){
  const start=new Date(Date.now());
  start.setSeconds(0,0);
  start.setMinutes(start.getMinutes()+2);
  const schedule=[];
  let offset=0;
  for(let i=0;i<12;i++){
    if(i>0)offset+=Math.random()<0.5?2:3;
    schedule.push(new Date(start.getTime()+offset*60000));
  }
  return schedule;
}
function randomTarget(){
  const levels=[3,4,5,6,7,8,9,10];
  return levels[Math.floor(Math.random()*levels.length)];
}
function renderSignals(){
  $("signalGrid").innerHTML=signals.map((s,i)=>`
    <div class="signal">
      <small>SINAL ${String(i+1).padStart(2,"0")}</small>
      <div class="signal-time">${formatTime(s.date)}</div>
      <div class="signal-protection">Proteção 2X-${s.target}X</div>
    </div>`).join("");
  $("resultTitle").textContent=selectedGame+" · "+selectedBet;
}

function setGenerationLock(key,lastSignalDate){
  const lastMinuteStart=new Date(lastSignalDate);
  lastMinuteStart.setSeconds(0,0);
  const until=lastMinuteStart.getTime()+60000;
  setCombinationLock(key,until);
  updateGenerationLock();
}
function formatRemaining(milliseconds){
  const totalSeconds=Math.max(0,Math.ceil(milliseconds/1000));
  const minutes=Math.floor(totalSeconds/60);
  const seconds=totalSeconds%60;
  const hours=Math.floor(minutes/60);
  const remainingMinutes=minutes%60;
  if(hours>0){
    return String(hours).padStart(2,"0")+":"+
      String(remainingMinutes).padStart(2,"0")+":"+
      String(seconds).padStart(2,"0");
  }
  return String(remainingMinutes).padStart(2,"0")+":"+
    String(seconds).padStart(2,"0");
}

function updateGenerationLock(){
  if($("demoPage").classList.contains("hidden"))return;
  clearExpiredLocks();

  const key=combinationKey();
  const until=getCombinationLock(key);
  const remaining=until-Date.now();
  const button=$("startDemo");
  const message=$("lockMessage");

  if(!selectedBet||!selectedGame){
    button.disabled=true;
    button.textContent="SELECIONA CASA E JOGO";
    message.textContent="Escolhe uma casa de apostas e um jogo para gerar sinais.";
    message.classList.remove("hidden");
    return;
  }
  if(remaining>0){
    button.disabled=true;
    button.textContent="AGUARDA "+formatRemaining(remaining);
    message.textContent="Esta combinação está bloqueada até terminar o último horário. Podes escolher outra casa ou outro jogo para gerar novos sinais.";
    message.classList.remove("hidden");
  }else{
    button.disabled=false;
    button.textContent="GERAR HORÁRIOS DOS SINAIS";
    message.textContent="Combinação disponível: "+selectedBet+" + "+selectedGame+".";
    message.classList.remove("hidden");
  }
}

function generateDemo(){
  if(!selectedBet||!selectedGame){
    $("selectionMessage").textContent="Seleciona uma plataforma e um jogo para continuar.";
    return;
  }
  const key=combinationKey();
  const until=getCombinationLock(key);
  if(Date.now()<until){
    updateGenerationLock();
    return;
  }
  signals=generateSchedule().map(date=>({date,target:randomTarget()}));
  renderSignals();
  $("resultsPanel").classList.remove("hidden");
  $("selectionMessage").textContent="";
  setGenerationLock(key,signals[signals.length-1].date);
}
function refreshNextSignal(){
  if(!signals.length){
    $("selectionMessage").textContent="Gera primeiro uma lista de sinais para esta combinação.";
    return;
  }
  const index=signals.findIndex(s=>s.date.getTime()>Date.now());
  if(index===-1){
    $("selectionMessage").textContent="Todos os horários desta lista já passaram.";
    return;
  }
  signals[index].target=randomTarget();
  renderSignals();
  $("selectionMessage").textContent="";
}

$("startDemo").onclick=generateDemo;
$("refreshDemo").onclick=refreshNextSignal;
setInterval(updateGenerationLock,250);

$("goDemo").onclick=()=>openUserPage("demo");
document.querySelectorAll(".nav").forEach(button=>{
  button.onclick=()=>openUserPage(button.dataset.page);
});

$("loginForm").onsubmit=e=>{
  e.preventDefault();
  const email=$("email").value.trim().toLowerCase();
  const password=$("password").value;
  const user=getUsers().find(u=>u.email===email&&u.password===password&&u.active);
  if(!user){
    $("loginError").textContent="Email ou senha incorretos, ou conta bloqueada.";
    return;
  }
  currentUser=user;
  $("loginError").textContent="";
  $("welcome").textContent=user.email;
  $("sideEmail").textContent=user.email;
  $("profileEmail").value=user.email;
  openUserPage("home");
  showScreen("userScreen");
};
$("logout").onclick=()=>{
  currentUser=null;
  $("password").value="";
  showScreen("loginScreen");
};

$("openAdmin").onclick=()=>{
  $("adminPassword").value="";
  $("adminError").textContent="";
  $("adminModal").classList.remove("hidden");
};
$("closeModal").onclick=()=>$("adminModal").classList.add("hidden");

$("adminForm").onsubmit=e=>{
  e.preventDefault();
  if($("adminPassword").value!==ADMIN_PASSWORD){
    $("adminError").textContent="Senha incorreta.";
    return;
  }
  $("adminModal").classList.add("hidden");
  resetForm();
  renderUsers();
  $("adminMessage").textContent="";
  showScreen("adminScreen");
};
$("backAdmin").onclick=()=>showScreen(currentUser?"userScreen":"loginScreen");

function resetForm(){
  editingEmail=null;
  $("accountForm").reset();
  $("newEmail").disabled=false;
  $("newPassword").required=true;
  $("newPassword").placeholder="";
  $("formTitle").textContent="Criar conta de utilizador";
  $("saveAccount").textContent="＋ Criar conta";
  $("cancelEdit").classList.add("hidden");
}
$("cancelEdit").onclick=resetForm;

$("accountForm").onsubmit=e=>{
  e.preventDefault();
  const email=$("newEmail").value.trim().toLowerCase();
  const password=$("newPassword").value;
  let users=getUsers();

  if(password.length<4){
    $("adminMessage").textContent="A senha precisa de pelo menos 4 caracteres.";
    return;
  }
  if(!editingEmail&&users.some(u=>u.email===email)){
    $("adminMessage").textContent="Já existe uma conta com esse email.";
    return;
  }
  if(editingEmail){
    users=users.map(u=>u.email===editingEmail?{...u,password}:u);
    $("adminMessage").textContent="Senha atualizada.";
  }else{
    users.push({email,password,active:true});
    $("adminMessage").textContent="Conta criada. O utilizador já pode entrar neste navegador.";
  }
  saveUsers(users);
  resetForm();
  renderUsers();
};

function renderUsers(){
  const users=getUsers();
  $("total").textContent=users.length;
  $("active").textContent=users.filter(u=>u.active).length;
  $("blocked").textContent=users.filter(u=>!u.active).length;
  $("usersTable").innerHTML=users.length?users.map((u,i)=>`
    <tr>
      <td>${i+1}</td>
      <td>${escapeHTML(u.email)}</td>
      <td><span class="pill ${u.active?"":"off"}">${u.active?"Ativa":"Bloqueada"}</span></td>
      <td>
        <button class="small" data-edit="${escapeHTML(u.email)}">Editar senha</button>
        <button class="small secondary" data-toggle="${escapeHTML(u.email)}">${u.active?"Bloquear":"Ativar"}</button>
        <button class="small danger" data-delete="${escapeHTML(u.email)}">Eliminar</button>
      </td>
    </tr>`).join(""):'<tr><td colspan="4">Ainda não existem contas.</td></tr>';
}

$("usersTable").onclick=e=>{
  const btn=e.target.closest("button");
  if(!btn)return;
  const email=btn.dataset.edit||btn.dataset.toggle||btn.dataset.delete;
  let users=getUsers();
  const user=users.find(u=>u.email===email);
  if(!user)return;

  if(btn.dataset.edit){
    editingEmail=email;
    $("newEmail").value=user.email;
    $("newPassword").value="";
    $("newPassword").placeholder="Introduz a nova senha";
    $("newPassword").required=true;
    $("newEmail").disabled=true;
    $("formTitle").textContent="Editar senha da conta";
    $("saveAccount").textContent="Guardar alterações";
    $("cancelEdit").classList.remove("hidden");
    $("adminMessage").textContent="Introduz a nova senha.";
    $("newPassword").focus();
  }
  if(btn.dataset.toggle){
    user.active=!user.active;
    saveUsers(users);
    renderUsers();
  }
  if(btn.dataset.delete&&confirm("Eliminar a conta "+email+"?")){
    saveUsers(users.filter(u=>u.email!==email));
    if(currentUser&&currentUser.email===email){
      currentUser=null;
      showScreen("loginScreen");
    }
    renderUsers();
    $("adminMessage").textContent="Conta eliminada.";
  }
};

$("exportCSV").onclick=()=>{
  const rows=[["Email","Estado"],...getUsers().map(u=>[u.email,u.active?"Ativa":"Bloqueada"])];
  const csv=rows.map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(",")).join("\r\n");
  const url=URL.createObjectURL(new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8;"}));
  const a=document.createElement("a");
  a.href=url;
  a.download="contas-crash-bot-moz.csv";
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
};

renderChoices();
renderUsers();
})();
