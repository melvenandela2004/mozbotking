
<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050916">
<title>CRASH BOT MOZ</title>

<style>
:root{
  --bg:#050916;--panel:#0b1730;--line:#1b3762;
  --blue:#168cff;--purple:#652cff;--cyan:#00e5ff;
  --text:#edf5ff;--muted:#9bb0d0;--green:#00d69a;--red:#ff4168;
}
*{box-sizing:border-box}
html{width:100%;min-height:100%;scroll-behavior:smooth}
body{
  margin:0;min-height:100vh;width:100%;overflow-x:hidden;
  color:var(--text);font-family:Arial,Helvetica,sans-serif;
  background:radial-gradient(circle at top left,#102657,transparent 40%),
  radial-gradient(circle at bottom right,#24104b,transparent 35%),var(--bg);
}
button,input{font:inherit}
button{
  cursor:pointer;border:0;border-radius:10px;padding:12px 16px;
  background:linear-gradient(110deg,var(--purple),var(--blue));
  color:white;font-weight:bold;transition:filter .2s;
}
button:hover{filter:brightness(1.15)}
button:disabled{opacity:.5;cursor:not-allowed;filter:none}
input{
  width:100%;min-width:0;padding:13px;background:#050d1c;color:white;
  border:1px solid #24436e;border-radius:9px;outline:none;margin-top:7px;
}
input:focus{border-color:var(--cyan)}
label{display:block;color:#b9cbe6;font-size:13px;margin:14px 0}
a{overflow-wrap:anywhere}
.hidden{display:none!important}
.app{width:100%;max-width:1320px;margin:auto;padding:20px}
header{
  display:flex;justify-content:space-between;align-items:center;
  gap:12px;margin-bottom:25px;flex-wrap:wrap;
}
.brand{font-size:22px;font-weight:900;overflow-wrap:anywhere}
.brand span{color:var(--cyan)}
.muted{color:var(--muted);font-size:13px;line-height:1.6}
.panel,.login-card,.hero,.sidebar{
  background:linear-gradient(145deg,#0b1730,#060d1c);
  border:1px solid var(--line);border-radius:17px;padding:22px;
  box-shadow:0 15px 40px #0003;min-width:0;
}
.login-layout{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,410px);
  gap:25px;align-items:center;min-height:70vh;
}
.intro h1{font-size:clamp(38px,6vw,65px);line-height:1;margin:15px 0}
.intro h1 span{color:var(--blue)}
.robot{font-size:100px;margin:20px 0;filter:drop-shadow(0 0 20px #168cff70)}
.eyebrow{color:var(--cyan);letter-spacing:2px;font-size:11px;font-weight:bold}
.login-card h2{text-align:center}
.login-card>.muted{text-align:center}
.full{width:100%;margin-top:12px;display:block;text-align:center}
.whatsapp{
  display:block;text-align:center;color:white;background:#087d54;
  border-radius:10px;padding:13px;margin-top:12px;font-weight:bold;
  text-decoration:none;overflow-wrap:anywhere;
}
.secondary{background:#10203b;border:1px solid var(--line)}
.error{color:#ff819a;font-size:13px;margin-top:10px;min-height:16px}
.notice{
  margin-top:15px;padding:12px;border:1px solid #725522;
  border-radius:10px;color:#f7d99b;font-size:12px;line-height:1.5;
}
.layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:18px}
.sidebar{display:flex;flex-direction:column;gap:8px;min-height:500px}
.nav{background:transparent;text-align:left;color:#b7c8e2;box-shadow:none}
.nav.active{background:#102c59;border:1px solid #214f8c}
.side-bottom{margin-top:auto;font-size:12px;color:var(--muted);line-height:1.8}
main{min-width:0}
.hero{margin-bottom:16px;background:linear-gradient(110deg,#0b1e42,#101448,#180e38)}
.hero h1{font-size:32px;margin:12px 0;overflow-wrap:anywhere}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:16px 0}
.stat{padding:18px;background:#0a1730;border:1px solid var(--line);border-radius:13px;min-width:0}
.stat small{color:var(--muted)}
.stat strong{display:block;font-size:25px;margin-top:12px;overflow-wrap:anywhere}
.panel{margin-bottom:16px}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px;flex-wrap:wrap}
h2{font-size:18px}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.bet-card,.game-card{
  text-align:center;padding:17px 12px;background:#08152c;
  border:1px solid var(--line);border-radius:13px;cursor:pointer;
  transition:.2s;min-width:0;overflow-wrap:anywhere;
}
.bet-card:hover,.game-card:hover{border-color:var(--cyan);transform:translateY(-2px)}
.bet-card.selected,.game-card.selected{border-color:var(--cyan);background:#10274a}
.bet-logo{font-size:22px;font-weight:900;color:var(--cyan);margin-bottom:10px;overflow-wrap:anywhere}
.bet-card p,.game-card p{font-size:12px;color:var(--muted);margin:7px 0}
.game-icon{font-size:30px;margin-bottom:8px}
.choice-note{
  padding:13px;border-radius:10px;background:#081a32;
  border:1px solid var(--line);margin:12px 0;font-size:13px;line-height:1.6;
  overflow-wrap:anywhere;
}
.pill{background:#063d35;color:#5dffd0;border-radius:20px;padding:5px 9px;font-size:11px}
.off{background:#47172b;color:#ff94ac}
.small{font-size:11px;padding:8px;margin:2px}
.danger{background:#9e1e43}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.signal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.signal{
  background:#071326;border:1px solid #17375d;border-radius:12px;
  padding:16px;text-align:center;min-width:0;
}
.signal-time{font-size:17px;color:white;font-weight:bold}
.signal-protection{margin-top:9px;font-size:14px;font-weight:bold;color:var(--cyan)}
.signal small{color:var(--muted)}
.clock{font-size:clamp(20px,4vw,24px);font-weight:bold;color:var(--cyan);margin:12px 0}
.lock-message{font-size:13px;color:#ffd479;text-align:center;margin-top:12px;line-height:1.6}
.table-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;min-width:490px}
th,td{text-align:left;padding:12px 8px;border-bottom:1px solid #18304f;font-size:13px}
th{color:var(--muted)}
footer{text-align:center;color:#6e84a8;font-size:11px;padding:20px}
.modal-bg{
  position:fixed;inset:0;background:#020611df;display:grid;
  place-items:center;padding:15px;z-index:5;overflow-y:auto;
}
.modal{
  width:min(430px,100%);max-height:calc(100dvh - 30px);overflow-y:auto;
  background:#081329;border:1px solid #28508a;border-radius:18px;padding:25px;
}

/* Tablets e computadores com ecrãs médios */
@media(max-width:1024px){
  .app{padding:16px}
  .layout{grid-template-columns:195px minmax(0,1fr);gap:14px}
  .login-layout{grid-template-columns:minmax(0,1fr) minmax(290px,370px);gap:18px}
  .panel,.login-card,.hero,.sidebar{padding:18px}
  .signal-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
}

/* Telemóveis e tablets em modo vertical */
@media(max-width:760px){
  .app{width:100%;padding:12px}
  header{align-items:center;flex-wrap:wrap;margin-bottom:18px}
  .brand{font-size:19px}
  header #openAdmin{padding:10px;font-size:12px}
  .login-layout,.layout{grid-template-columns:minmax(0,1fr);gap:14px;min-height:auto}
  .intro{text-align:center}
  .intro h1{font-size:clamp(36px,9vw,48px)}
  .robot{font-size:65px;margin:14px 0}
  .login-card,.panel,.hero,.sidebar{padding:16px;min-width:0}
  .hero h1{font-size:clamp(24px,6vw,32px)}
  .sidebar{
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
    gap:8px;min-height:auto;
  }
  .sidebar>.brand,.side-bottom{grid-column:1/-1}
  .side-bottom{margin-top:8px}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .stat{padding:13px}
  .stat strong{font-size:clamp(17px,4vw,23px)}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
  .bet-card,.game-card{padding:14px 8px}
  .signal-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .signal{padding:12px 6px}
  .signal-time{font-size:clamp(14px,4vw,17px)}
  .signal-protection{font-size:12px}
  .form-grid{grid-template-columns:minmax(0,1fr)}
  .panel-head{align-items:flex-start}
  table{min-width:490px}
  button{max-width:100%;overflow-wrap:anywhere}
  .modal{padding:18px}
}

/* Telemóveis estreitos */
@media(max-width:380px){
  .app{padding:8px}
  .cards{grid-template-columns:minmax(0,1fr)}
  .sidebar{grid-template-columns:minmax(0,1fr)}
  .sidebar>.brand,.side-bottom{grid-column:auto}
  .signal-grid,.grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .panel,.hero,.login-card,.sidebar{padding:12px}
}

/* Monitores grandes */
@media(min-width:1400px){
  .app{max-width:1320px}
}
</style>
</head>
<body>
<div class="app">

<header>
  <div class="brand">⚡ CRASH <span>BOT</span> MOZ
    <div class="muted">SMART GAMING INTERFACE</div>
  </div>
  <button id="openAdmin">⚙ Painel Admin</button>
</header>

<section id="loginScreen" class="login-layout">
  <div class="intro">
    <div class="eyebrow">SISTEMA • MOÇAMBIQUE</div>
    <h1>CRASH BOT<br><span>MOZ</span></h1>
    <p class="muted">Entra na tua conta para aceder ao painel e aos horários dos sinais.</p>
    <div class="robot">🤖</div>
