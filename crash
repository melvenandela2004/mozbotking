      </div>

      <div class="panel">
        <div class="panel-head"><h2>🎮 Escolhe o jogo</h2><span class="pill">4 OPÇÕES</span></div>
        <div id="gameGrid" class="grid"></div>
      </div>

      <div class="panel">
        <div class="panel-head"><h2>🏆 Plataforma selecionada</h2></div>
        <div id="betGrid" class="grid"></div>
        <div class="choice-note">Casa: <b id="chosenBet">Nenhuma</b><br>Jogo: <b id="chosenGame">Nenhum</b></div>
        <button id="startDemo" class="full">GERAR HORÁRIOS DOS SINAIS</button>
