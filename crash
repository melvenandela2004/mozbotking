  </main>
</section>

<section id="adminScreen" class="hidden">
  <div class="panel-head">
    <div><div class="eyebrow">CONTROLO DO SISTEMA</div><h1>Painel do Administrador</h1></div>
    <button class="secondary" id="backAdmin">← Voltar</button>
  </div>

  <div class="cards">
    <div class="stat"><small>TOTAL DE CONTAS</small><strong id="total">0</strong></div>
    <div class="stat"><small>CONTAS ATIVAS</small><strong id="active" style="color:var(--green)">0</strong></div>
